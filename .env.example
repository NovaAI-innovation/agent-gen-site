# Copy to .env and fill in values. .env is gitignored and must never be committed.
# Variables already set in the environment take precedence over .env.

# Sanity read token (build-time only; never shipped to the client).
# Either set the token directly:
# SANITY_READ_TOKEN=
# or point at a gitignored file that defines SANITY_READ_TOKEN:
SANITY_ENV_FILE=/path/to/sanity-agent-gen.env

# Preview deploy only (never the apex). Used by scripts/deploy-preview.sh.
DEPLOY_HOST=user@your-preview-host
DEPLOY_KEY=/path/to/ssh-deploy-key
