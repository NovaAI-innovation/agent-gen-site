{
  "name": "agent-gen-site",
  "version": "1.0.0",
  "description": "agent-gen.ca day-1 site (React + Vite, prerendered static HTML)",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "fetch": "node scripts/fetch-content.mjs",
    "build": "npm run tokens && npm run fetch && vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs && node scripts/check-dist.mjs",
    "build:production": "SITE_ENV=production npm run build",
    "check": "node scripts/check-dist.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy-preview.sh",
    "deploy:preview": "bash scripts/deploy-preview.sh"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@sanity/client": "^8.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true
}
